# Copied to ~/.config/tg-gate/config by `tg-gate install` if missing.
# Schedule modes are HARDCODED in bin/tg-gate (not controlled here).
# Protect after install:  chmod 444 ~/.config/tg-gate/config
# Stronger:              sudo chattr +i ~/.config/tg-gate/config

FLATPAK_ID=org.telegram.desktop
CONFIRM_PHRASE="i need telegram"
UNLOCK_DELAY_MINUTES=10
UNLOCK_COOLDOWN_MINUTES=180
